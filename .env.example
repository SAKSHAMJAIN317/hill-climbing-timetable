# SmartSched AI - Environment Configuration Template
# Copy this file to .env or export these variables in your terminal

# Spring Profile ('dev' for in-memory H2, 'mysql' for native MySQL 8)
SPRING_PROFILES_ACTIVE=mysql

# Application Server Port
PORT=8080

# MySQL 8 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartsched_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
